// Cloudflare Workers configuration (used by `npx wrangler dev` and by Cloudflare's
// Git deployment). Setup steps are in README.md.
{
	"name": "kvp-blog",
	"compatibility_date": "2026-09-01",
	// Small Worker for the reactions API (worker/index.js). It only runs for
	// requests that are not a file in ./public.
	"main": "worker/index.js",
	// The site built by Hugo (`hugo` writes it to ./public).
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	// Database for reaction counts. Replace database_id with the id printed by
	// `npx wrangler d1 create kvp-blog`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kvp-blog",
			"database_id": "d19f9842-c4fd-44ce-967f-cf29ab427353",
			"migrations_dir": "worker/migrations"
		}
	],
	// Test site on dev.kvppartners.com: a second Worker, kvp-blog-dev, built from the dev
	// branch and deployed with `npx wrangler deploy --env dev`. Everything above is the
	// production site and stays as it is. The test site has its own database, so test
	// reactions and problem reports never reach production. Setup steps are in README.md.
	"env": {
		"dev": {
			// Only dev.kvppartners.com, which Cloudflare Access protects with a login (README.md):
			// no public *.workers.dev address or preview URLs that would skip the login.
			"workers_dev": false,
			"preview_urls": false,
			"assets": {
				"directory": "./public",
				"binding": "ASSETS",
				"not_found_handling": "404-page"
			},
			// Replace database_id with the id printed by `npx wrangler d1 create kvp-blog-dev`.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kvp-blog-dev",
					"database_id": "8f2fdfe9-7225-4406-8ae1-8891476ac3d1",
					"migrations_dir": "worker/migrations"
				}
			]
		}
	}
}